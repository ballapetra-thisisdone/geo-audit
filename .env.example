# Másold .env néven, és töltsd ki. Minden külső kulcs opcionális: kulcs nélkül az adott modul
# „nincs konfigurálva” állapotba kerül, a crawl, a technikai és a tartalmi audit attól még teljes.

# API port (a Vite dev szerver erre proxyz)
GEO_API_PORT=4317

# Headless böngésző a renderelt DOM-hoz: msedge | chrome | (üres = automatikus)
BROWSER_CHANNEL=msedge
# Ha a böngésző nem a szokásos helyen van:
# GEO_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Adatkönyvtár (v1: JSON; v2: SQLite adatbázis – data/geo-site.sqlite)
DATA_DIR=./data
# GEO_DB_FILE=./data/geo-site.sqlite

# Háttérfeladatok: 1 = az API-szerver futtatja a workert (alapértelmezett); 0 = külön folyamat (npm run worker)
GEO_EMBEDDED_WORKER=1
GEO_WORKER_CONCURRENCY=1

# --- LLM-értékelés (Claude) ---
# Szemantikai oldalértékelés és kérdés-lefedettség ellenőrzés (idézet-validálással). Üresen: kikapcsolva.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# LLM_MODEL=claude-opus-5-5

# --- AI/search visibility adapterek (tényleges válaszok és citationök) ---
# OpenAI Responses API + web_search (https://developers.openai.com/api/docs/guides/tools-web-search)
OPENAI_API_KEY=
# OPENAI_SEARCH_MODEL=gpt-5.5
# Perplexity Sonar API (https://docs.perplexity.ai)
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar
# Brave Search API – klasszikus SERP (https://api-dashboard.search.brave.com)
BRAVE_SEARCH_API_KEY=
# Claude web search – ugyanazt az ANTHROPIC_API_KEY-t használja, ezért külön kell engedélyezni:
CLAUDE_SEARCH_ENABLED=0
# CLAUDE_SEARCH_MODEL=claude-opus-5-5

# Csak tesztkörnyezetben! Belső/privát hálózati címek vizsgálatának engedélyezése (SSRF-védelem kikapcsolása).
# GEO_ALLOW_PRIVATE_HOSTS=1
